AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
GOOGLE_APPLICATION_CREDENTIALS=
DEV_MODERATION_SECRET=
DEV_SEED_CATALOG=false
REDIS_URL=
OPENAI_API_KEY=
OPENAI_BOOK_ANALYSIS_MODEL=gpt-4o-mini
BOOK_ANALYSIS_PIPELINE_VERSION=v1
BOOK_ANALYSIS_PROMPT_VERSION=v1
OCR_PIPELINE_VERSION=v1
