# Mobile/public values (safe to bundle)
EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_MAX_UPLOAD_SIZE_MB=100

# Backend API server-only configuration (do not prefix these with EXPO_PUBLIC_)
PORT=3000
HOST=0.0.0.0
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
CORS_ORIGIN=*
JSON_BODY_LIMIT=100kb
AWS_REGION=
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
MAX_UPLOAD_SIZE_MB=100
S3_PRESIGNED_URL_EXPIRES_SECONDS=600
EXTRACTION_POLL_INTERVAL_MS=3000
EXTRACTION_MAX_ATTEMPTS=3
EXTRACTION_TEMP_DIR=
EXTRACTION_PIPELINE_VERSION=v1
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server/worker only — never expose these through EXPO_PUBLIC_* variables
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DATABASE_URL=
OPENAI_API_KEY=
OPENAI_BOOK_ANALYSIS_MODEL=
OPENAI_SUMMARY_MODEL=
ELEVENLABS_API_KEY=
ELEVENLABS_TTS_MODEL=
